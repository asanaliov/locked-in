<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:LockedIn.App.Controls">

    <!-- Colours are filled in by ThemeManager; these are just the light defaults for the designer. -->
    <SolidColorBrush x:Key="Bg" Color="#F5F5F7" />
    <SolidColorBrush x:Key="Card" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Raised" Color="#1F767680" />
    <SolidColorBrush x:Key="Text" Color="#1D1D1F" />
    <SolidColorBrush x:Key="Muted" Color="#6E6E73" />
    <SolidColorBrush x:Key="Border" Color="#14000000" />
    <SolidColorBrush x:Key="Accent" Color="#0071E3" />
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentSoft" Color="#260071E3" />
    <SolidColorBrush x:Key="Focus" Color="#34C759" />
    <SolidColorBrush x:Key="Neutral" Color="#AEAEB2" />
    <SolidColorBrush x:Key="Distraction" Color="#FF3B30" />

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>

    <BooleanToVisibilityConverter x:Key="Visible" />

    <!-- Text -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,0,0,18" />
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style x:Key="StatValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Cards -->
    <Style x:Key="CardPanel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Margin" Value="0,0,0,14" />
    </Style>

    <!-- Shown only when moving with the keyboard. -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" RadiusX="9" RadiusY="9" Stroke="{DynamicResource Accent}" StrokeThickness="2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Pill buttons: the top navigation and segmented choices -->
    <Style x:Key="NavPill" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Pill" Background="Transparent" CornerRadius="16" Padding="14,6" Margin="2,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Raised}" />
                            <Setter Property="Foreground" Value="{DynamicResource Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Pill" Background="Transparent" CornerRadius="7" Padding="11,4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Accent}" />
                            <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SegmentGroup" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Raised}" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- Accent colour swatch -->
    <Style x:Key="Swatch" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Width="28" Height="28">
                        <Ellipse x:Name="Ring" Stroke="{DynamicResource Text}" StrokeThickness="2" Opacity="0" />
                        <Ellipse Margin="4" Fill="{TemplateBinding Background}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- On/off switch -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Track" Width="44" Height="26" CornerRadius="13" Background="{DynamicResource Raised}">
                        <Ellipse x:Name="Thumb" Width="20" Height="20" Fill="White" HorizontalAlignment="Left" Margin="2,0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- One app: icon, name, a bar scaled to the longest app, and its time. Shared by Today, Screen time and Top apps. -->
    <DataTemplate x:Key="AppRow">
        <Grid Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>
            <controls:AppIconView AppName="{Binding AppName}" Category="{Binding Category}" HorizontalAlignment="Left" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Text="{Binding AppName}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Sub}" Style="{StaticResource MutedText}" FontSize="12" Visibility="{Binding HasSub, Converter={StaticResource Visible}}" />
            </StackPanel>
            <controls:SegmentBar Grid.Column="2" Height="8" VerticalAlignment="Center" Segments="{Binding Bar}" Total="{Binding Total}" />
            <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                <TextBlock Text="{Binding Time}" FontWeight="Medium" HorizontalAlignment="Right" />
                <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" FontSize="12" HorizontalAlignment="Right" Visibility="{Binding HasDetail, Converter={StaticResource Visible}}" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- A thin scrollbar that fits both themes -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="{DynamicResource Muted}" Opacity="0.45" CornerRadius="4" Margin="2" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
