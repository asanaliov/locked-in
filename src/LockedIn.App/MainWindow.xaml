<Window x:Class="LockedIn.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Locked In" Width="1020" Height="860" MinWidth="600" MinHeight="460"
        Icon="lockedin.ico"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <DockPanel>
        <!-- The title bar already shows the icon and name, so the header is just the navigation,
             lined up with the page content below (the first pill's text starts where the page title does). -->
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="0,8">
            <Grid MaxWidth="960" Margin="24,0">
                <StackPanel x:Name="Nav" Orientation="Horizontal" Margin="-16,0,0,0">
                    <RadioButton Content="Today" Tag="Today" GroupName="Nav" Style="{StaticResource NavPill}" Checked="OnNavigate" />
                    <RadioButton Content="Screen time" Tag="ScreenTime" GroupName="Nav" Style="{StaticResource NavPill}" Checked="OnNavigate" />
                    <RadioButton Content="Last 7 days" Tag="History" GroupName="Nav" Style="{StaticResource NavPill}" Checked="OnNavigate" />
                    <RadioButton Content="Top apps" Tag="Apps" GroupName="Nav" Style="{StaticResource NavPill}" Checked="OnNavigate" />
                    <RadioButton Content="Settings" Tag="Settings" GroupName="Nav" Style="{StaticResource NavPill}" Checked="OnNavigate" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel MaxWidth="960" Margin="24,24,24,16">
                <ContentControl x:Name="Page" Focusable="False" />
                <TextBlock Style="{StaticResource MutedText}" FontSize="12" Margin="2,10,0,0">
                    <Run Text="All data stays on this machine. ·" />
                    <Run x:Name="Version" />
                    <Run Text="· made by" />
                    <Hyperlink NavigateUri="https://github.com/asanaliov" RequestNavigate="OnLink" Foreground="{DynamicResource Muted}">Asan</Hyperlink>
                    <Run Text="·" />
                    <Hyperlink NavigateUri="https://github.com/asanaliov/locked-in" RequestNavigate="OnLink" Foreground="{DynamicResource Muted}">source</Hyperlink>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
