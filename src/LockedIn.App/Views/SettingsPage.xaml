<UserControl x:Class="LockedIn.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SettingName" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <Style x:Key="Setting" TargetType="Grid">
            <Setter Property="Margin" Value="0,8" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />

        <Border Style="{StaticResource CardPanel}">
            <StackPanel>
                <TextBlock Text="Appearance" Style="{StaticResource CardTitle}" />
                <Grid Style="{StaticResource Setting}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Theme" Style="{StaticResource SettingName}" />
                        <TextBlock Text="System follows your Windows light or dark mode." Style="{StaticResource MutedText}" />
                    </StackPanel>
                    <ContentControl x:Name="ThemeChoice" Grid.Column="1" VerticalAlignment="Center" Focusable="False" />
                </Grid>
                <Grid Style="{StaticResource Setting}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Accent colour" Style="{StaticResource SettingName}" />
                        <TextBlock Text="Used for the score ring, charts and highlights." Style="{StaticResource MutedText}" />
                    </StackPanel>
                    <StackPanel x:Name="AccentChoice" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" />
                </Grid>
                <Grid Style="{StaticResource Setting}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Animations" Style="{StaticResource SettingName}" />
                        <TextBlock Text="Turn off to show everything instantly." Style="{StaticResource MutedText}" />
                    </StackPanel>
                    <CheckBox x:Name="Animations" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="OnChanged" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardPanel}">
            <StackPanel>
                <TextBlock Text="Tracking" Style="{StaticResource CardTitle}" />
                <Grid Style="{StaticResource Setting}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Stop counting after" Style="{StaticResource SettingName}" />
                        <TextBlock Text="How long without keyboard or mouse input before you count as away." Style="{StaticResource MutedText}" />
                    </StackPanel>
                    <ContentControl x:Name="IdleChoice" Grid.Column="1" VerticalAlignment="Center" Focusable="False" />
                </Grid>
                <Grid Style="{StaticResource Setting}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Save window titles" Style="{StaticResource SettingName}" />
                        <TextBlock Text="Off keeps titles private: they're only used to sort browser tabs and are never saved." Style="{StaticResource MutedText}" />
                    </StackPanel>
                    <CheckBox x:Name="StoreTitles" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="OnChanged" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardPanel}">
            <StackPanel>
                <TextBlock Text="Locked In Score" Style="{StaticResource CardTitle}" />
                <Grid Style="{StaticResource Setting}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Streak break allowance" Style="{StaticResource SettingName}" />
                        <TextBlock Text="Breaks shorter than this, like a quick look at chat, don't end a deep work streak." Style="{StaticResource MutedText}" />
                    </StackPanel>
                    <ContentControl x:Name="StreakChoice" Grid.Column="1" VerticalAlignment="Center" Focusable="False" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardPanel}">
            <StackPanel>
                <TextBlock Text="App categories" Style="{StaticResource CardTitle}" />
                <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,12"
                           Text="Changing a category also updates that app's past sessions. Browsers are classified per tab title using the keywords in lockedin.json; their setting only applies when no keyword matches." />
                <ItemsControl x:Name="Categories" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
