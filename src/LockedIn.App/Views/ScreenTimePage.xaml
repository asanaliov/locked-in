<UserControl x:Class="LockedIn.App.Views.ScreenTimePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:LockedIn.App.Controls">
    <StackPanel>
        <TextBlock Text="Screen time" Style="{StaticResource PageTitle}" />

        <Border Style="{StaticResource CardPanel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Total}" FontFamily="{StaticResource DisplayFont}" FontSize="40" FontWeight="Bold" />
                    <TextBlock Text="{Binding Comparison}" Style="{StaticResource MutedText}" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Average}" Style="{StaticResource StatValue}" />
                    <TextBlock Text="Daily average, last 7 days" Style="{StaticResource MutedText}" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding MostUsed}" Style="{StaticResource StatValue}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="Most used today" Style="{StaticResource MutedText}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Style="{StaticResource CardPanel}">
            <StackPanel>
                <TextBlock Text="Today by hour" Style="{StaticResource CardTitle}" />
                <c:ColumnChart x:Name="HoursChart" Height="190" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardPanel}">
            <StackPanel>
                <TextBlock Text="Last 7 days" Style="{StaticResource CardTitle}" />
                <c:ColumnChart x:Name="WeekChart" Height="220" />
                <TextBlock Text="Dashed line: your daily average" Style="{StaticResource MutedText}" FontSize="12" Margin="44,6,0,0" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardPanel}">
            <StackPanel>
                <TextBlock Text="Apps today" Style="{StaticResource CardTitle}" />
                <TextBlock Text="Nothing tracked yet today." Style="{StaticResource MutedText}" Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}" />
                <ItemsControl ItemsSource="{Binding Apps}" ItemTemplate="{StaticResource AppRow}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
