<UserControl x:Class="LockedIn.App.Views.AppsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Top apps" Style="{StaticResource PageTitle}" />

        <Border Style="{StaticResource SegmentGroup}" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="Today" Tag="1" GroupName="Period" Style="{StaticResource Segment}" Checked="OnPeriodChecked" />
                <RadioButton Content="7 days" Tag="7" GroupName="Period" Style="{StaticResource Segment}" Checked="OnPeriodChecked" IsChecked="True" />
                <RadioButton Content="30 days" Tag="30" GroupName="Period" Style="{StaticResource Segment}" Checked="OnPeriodChecked" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardPanel}">
            <StackPanel>
                <TextBlock x:Name="Empty" Text="No apps tracked in this period." Style="{StaticResource MutedText}" Visibility="Collapsed" />
                <ItemsControl x:Name="List" ItemTemplate="{StaticResource AppRow}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
