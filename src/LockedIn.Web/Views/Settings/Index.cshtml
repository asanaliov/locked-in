@model SettingsViewModel
@{
    ViewData["Title"] = "Settings";
    var general = Model.General;
    var accentSwatches = new Dictionary<Accent, string> { [Accent.Blue] = "#0071e3", [Accent.Graphite] = "#6e6e73", [Accent.Orange] = "#ff9500" };
    string Minutes(int m) => m == 1 ? "1 minute" : $"{m} minutes";
    string Seconds(int s) => s < 60 ? $"{s} seconds" : Minutes(s / 60);
}

<h1>Settings</h1>

<form asp-action="SaveGeneral" method="post" onchange="this.requestSubmit()">
    <div class="card">
        <h2>Appearance</h2>

        <div class="setting">
            <div>
                <div class="setting-name">Theme</div>
                <div class="setting-hint">System follows your Windows light or dark mode.</div>
            </div>
            <div class="segmented" role="radiogroup" aria-label="Theme">
                @foreach (var theme in Enum.GetValues<Theme>())
                {
                    <label><input type="radio" name="Theme" value="@theme" checked="@(general.Theme == theme)" />@theme</label>
                }
            </div>
        </div>

        <div class="setting">
            <div>
                <div class="setting-name">Accent colour</div>
                <div class="setting-hint">Used for the score ring, charts and highlights.</div>
            </div>
            <div class="swatches" role="radiogroup" aria-label="Accent colour">
                @foreach (var (accent, color) in accentSwatches)
                {
                    <label class="swatch" style="--swatch: @color" title="@accent">
                        <input type="radio" name="Accent" value="@accent" checked="@(general.Accent == accent)" aria-label="@accent" />
                    </label>
                }
            </div>
        </div>

        <div class="setting">
            <div>
                <div class="setting-name">Animations</div>
                <div class="setting-hint">Turn off to show everything instantly.</div>
            </div>
            <input class="switch" type="checkbox" name="Animations" value="true" checked="@general.Animations" aria-label="Animations" />
        </div>
    </div>

    <div class="card">
        <h2>Tracking</h2>

        <div class="setting">
            <div>
                <div class="setting-name">Stop counting after</div>
                <div class="setting-hint">How long without keyboard or mouse input before you count as away.</div>
            </div>
            <select name="IdleMinutes" aria-label="Stop counting after">
                @foreach (var minutes in GeneralSettings.IdleMinuteChoices)
                {
                    <option value="@minutes" selected="@(general.IdleMinutes == minutes)">@Minutes(minutes)</option>
                }
            </select>
        </div>

        <div class="setting">
            <div>
                <div class="setting-name">Save window titles</div>
                <div class="setting-hint">Off keeps titles private: they're only used to sort browser tabs and are never saved.</div>
            </div>
            <input class="switch" type="checkbox" name="StoreWindowTitles" value="true" checked="@general.StoreWindowTitles" aria-label="Save window titles" />
        </div>
    </div>

    <div class="card">
        <h2>Locked-In Score</h2>

        <div class="setting">
            <div>
                <div class="setting-name">Streak break allowance</div>
                <div class="setting-hint">Breaks shorter than this, like a quick look at chat, don't end a deep work streak.</div>
            </div>
            <select name="StreakToleranceSeconds" aria-label="Streak break allowance">
                @foreach (var seconds in GeneralSettings.StreakToleranceChoices)
                {
                    <option value="@seconds" selected="@(general.StreakToleranceSeconds == seconds)">@Seconds(seconds)</option>
                }
            </select>
        </div>
    </div>
</form>

<h2 id="categories" class="section-title">App categories</h2>
<p class="muted">
    Changing a category also updates that app's past sessions. Browsers are classified per tab title
    using the keywords in <code>lockedin.json</code>; their override only applies when no keyword matches.
</p>

<div class="card">
    <table>
        <thead>
            <tr><th>App</th><th>Default</th><th>Category</th></tr>
        </thead>
        <tbody>
            @foreach (var app in Model.Apps)
            {
                <tr>
                    <td>@app.AppName @if (app.IsBrowser) { <span class="muted">(browser)</span> }</td>
                    <td class="muted">@app.DefaultCategory</td>
                    <td>
                        <form asp-action="SetCategory" method="post">
                            <input type="hidden" name="appName" value="@app.AppName" />
                            <span class="dot @app.Effective"></span>
                            <select name="category" onchange="this.form.submit()">
                                <option value="" selected="@(app.Override is null)">Default (@app.DefaultCategory)</option>
                                @foreach (var category in Enum.GetValues<Category>())
                                {
                                    <option value="@category" selected="@(app.Override == category)">@category</option>
                                }
                            </select>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
