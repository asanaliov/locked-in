@model int
@{
    var current = LockInStages.For(Model);
}
<div class="card">
    <h2>Stage of locked in</h2>
    <p class="stage-name">@current.Name</p>
    <ol class="stages">
        @foreach (var stage in LockInStages.All)
        {
            var isCurrent = stage == current;
            <li class="stage @(isCurrent ? "current" : null)" aria-current="@(isCurrent ? "step" : null)">
                <img src="~/_content/LockedIn.Web/img/stages/stage-@(stage.Level).svg"
                     alt="Stage @stage.Level of @LockInStages.All.Count: @stage.Name" loading="lazy" />
                <span class="stage-label">@stage.Name</span>
                <span class="stage-range">@stage.MinScore–@LockInStages.MaxScore(stage)</span>
            </li>
        }
    </ol>
</div>
