<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · locked-in</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script>
        const css = getComputedStyle(document.documentElement);
        const categoryColors = {
            Focus: css.getPropertyValue('--focus').trim(),
            Neutral: css.getPropertyValue('--neutral').trim(),
            Distraction: css.getPropertyValue('--distraction').trim(),
        };
        Chart.defaults.color = css.getPropertyValue('--muted').trim();
        Chart.defaults.borderColor = css.getPropertyValue('--border').trim();
        Chart.defaults.font.family = css.getPropertyValue('--font').trim();
        Chart.defaults.plugins.legend.display = false;
    </script>
</head>
<body>
    <header>
        <nav>
            <a class="brand" asp-controller="Today" asp-action="Index">locked-in</a>
            <a asp-controller="Today" asp-action="Index">Today</a>
            <a asp-controller="History" asp-action="Index">Last 7 days</a>
            <a asp-controller="Apps" asp-action="Index">Top apps</a>
            <a asp-controller="Settings" asp-action="Index">Settings</a>
        </nav>
    </header>
    <main>
        @RenderBody()
    </main>
    <footer>
        <p>All data stays on this machine. The session you're in right now shows up once you switch apps or go idle.</p>
        <p>locked-in v@(typeof(Program).Assembly.GetName().Version?.ToString(3)) · made by <a href="https://github.com/asanaliov">Asan</a> · <a href="https://github.com/asanaliov/locked-in">source</a></p>
    </footer>
</body>
</html>
