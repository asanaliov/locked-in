@model TopAppsViewModel
@{
    ViewData["Title"] = "Top apps";
    var longest = Model.Metrics.Apps.FirstOrDefault()?.Time ?? TimeSpan.Zero;
}

<h1>Top apps</h1>

<div class="tabs">
    @foreach (var (days, label) in new[] { (1, "Today"), (7, "7 days"), (30, "30 days") })
    {
        <a asp-action="Index" asp-route-days="@days" class="@(days == Model.Days ? "active" : null)">@label</a>
    }
</div>

<div class="card" style="padding: 0">
    @if (Model.Metrics.Apps.Count == 0)
    {
        <div class="empty">No apps tracked in this period.</div>
    }
    else
    {
        <ul class="app-list">
            @foreach (var app in Model.Metrics.Apps)
            {
                <li class="app-row">
                    <div class="app-icon @app.Category" aria-hidden="true">@app.AppName[..1].ToUpperInvariant()</div>
                    <div>
                        <div class="app-name">@app.AppName</div>
                        <div class="app-sub">@app.Category</div>
                    </div>
                    <div class="bar-cell"><div class="bar @app.Category" style="width: @((app.Time / longest * 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></div></div>
                    <div class="app-time">
                        @Format.Duration(app.Time)
                        <small>@Format.Percent(app.Time / Model.Metrics.ActiveTime)</small>
                    </div>
                </li>
            }
        </ul>
    }
</div>
