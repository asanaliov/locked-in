@model DayMetrics
@{
    ViewData["Title"] = "Today";
    var apps = Model.Apps.Take(15).ToList();
}

<div class="page-head">
    <div class="date">@DateTime.Now.ToString("dddd, d MMMM")</div>
    <h1>Today</h1>
</div>

<div class="bento">
    <div class="card tile score-tile span-2 tall">
        <div class="ring" style="--score: @Model.Score">
            <svg viewBox="0 0 100 100" aria-hidden="true">
                <circle class="track" cx="50" cy="50" r="44" />
                <circle class="progress" cx="50" cy="50" r="44" pathLength="100" />
            </svg>
            <div class="value">
                <span id="score" data-value="@Model.Score">@Model.Score</span>
                <small>Locked In Score</small>
            </div>
        </div>
        <div class="caption">@Format.Duration(Model.FocusTime) of focus so far</div>
    </div>

    <div class="card tile">
        <div class="tile-label"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>Active time</div>
        <div class="stat-value">@Format.Duration(Model.ActiveTime)</div>
    </div>
    <div class="card tile">
        <div class="tile-label"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="12" r="9" /><circle cx="12" cy="12" r="5" /><circle cx="12" cy="12" r="1" /></svg>Focus ratio</div>
        <div class="stat-value">@Format.Percent(Model.FocusRatio)</div>
    </div>
    <div class="card tile">
        <div class="tile-label"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"><path d="M12 3c1 3 5 5 5 10a5 5 0 0 1-10 0c0-2 1-3.5 2-4.5.5 2 1.5 3 3 3-1-3 0-6 0-8.5Z" /></svg>Longest streak</div>
        <div class="stat-value">@Format.Duration(Model.LongestStreak)</div>
    </div>
    <div class="card tile">
        <div class="tile-label"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h3c4 0 6 10 10 10h3M17 14l3 3-3 3M4 17h3c1.5 0 2.7-1.4 3.8-3.2M13.2 10.2C14.3 8.4 15.5 7 17 7h3M17 4l3 3-3 3" /></svg>Switches / hour</div>
        <div class="stat-value">@Model.SwitchesPerHour.ToString("0.#")</div>
    </div>

    @if (Model.ActiveTime == TimeSpan.Zero)
    {
        <div class="card empty span-4">
            <img src="~/_content/LockedIn.Web/img/empty-state.svg" alt="A brain with a thought bubble, wondering where to start" />
            <p class="empty-title">Nothing tracked yet today</p>
            <p>Pondering where to start? Open an app and get going. Your day shows up here as you work.</p>
        </div>
    }
    else
    {
        <partial name="_StageLadder" model="Model.Score" />

        <div class="card span-4">
            <h2>Breakdown</h2>
            <partial name="_CategoryBreakdown" model="Model" />
        </div>

        <div class="card span-4">
            <h2>Time per app</h2>
            <div style="height: @(apps.Count * 30 + 40)px"><canvas id="apps"></canvas></div>
        </div>
    }
</div>

<script>
    (() => {
        const el = document.getElementById('score');
        const target = +el.dataset.value;
        if (reduceMotion) return;
        const start = performance.now() + 150;
        el.textContent = 0;
        const tick = now => {
            const t = Math.min(Math.max((now - start) / 1400, 0), 1);
            el.textContent = Math.round(target * (1 - Math.pow(1 - t, 4)));
            if (t < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
    })();
</script>

@if (apps.Count > 0)
{
    <script>
        const apps = @Json.Serialize(apps.Select(a => new { name = a.AppName, category = a.Category.ToString(), minutes = Math.Round(a.Time.TotalMinutes, 1) }));
        new Chart(document.getElementById('apps'), {
            type: 'bar',
            data: {
                labels: apps.map(a => a.name),
                datasets: [{
                    data: apps.map(a => a.minutes),
                    backgroundColor: apps.map(a => categoryColors[a.category]),
                    borderRadius: 999,
                    borderSkipped: false,
                    barPercentage: 0.6,
                }],
            },
            options: {
                indexAxis: 'y',
                maintainAspectRatio: false,
                animation: { delay: ctx => ctx.type === 'data' && ctx.mode === 'default' ? 300 + ctx.dataIndex * 40 : 0 },
                scales: {
                    x: { title: { display: true, text: 'minutes' }, grid: { drawTicks: false }, border: { display: false } },
                    y: { grid: { display: false }, border: { display: false } },
                },
            },
        });
    </script>
}
