<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Text -->
    <Style Selector="TextBlock.pageTitle">
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,0,0,18" />
    </Style>
    <Style Selector="TextBlock.cardTitle">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style Selector="TextBlock.statValue">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.settingName">
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <!-- Cards -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Margin" Value="0,0,0,14" />
    </Style>

    <!-- Top navigation -->
    <Style Selector="RadioButton.nav">
        <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Pill" Background="Transparent" CornerRadius="16" Padding="14,6" Margin="2,0">
                    <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.nav:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
    </Style>
    <Style Selector="RadioButton.nav:checked">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
    </Style>
    <Style Selector="RadioButton.nav:checked /template/ Border#Pill">
        <Setter Property="Background" Value="{DynamicResource Raised}" />
    </Style>
    <Style Selector="RadioButton.nav:pressed /template/ Border#Pill">
        <Setter Property="Background" Value="{DynamicResource Raised}" />
        <Setter Property="Opacity" Value="0.7" />
    </Style>

    <!-- Segmented choices -->
    <Style Selector="RadioButton.segment">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Pill" Background="Transparent" CornerRadius="7" Padding="11,4">
                    <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.segment:checked">
        <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
    </Style>
    <Style Selector="RadioButton.segment:checked /template/ Border#Pill">
        <Setter Property="Background" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="Border.segmentGroup">
        <Setter Property="Background" Value="{DynamicResource Raised}" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- Buttons: a quiet one and a filled accent one -->
    <Style Selector="Button.quiet">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="Background" Value="{DynamicResource Raised}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Pill" Background="{TemplateBinding Background}" CornerRadius="8" Padding="14,6" RenderTransform="scale(1)">
                    <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.quiet:pointerover /template/ Border#Pill">
        <Setter Property="Opacity" Value="0.85" />
    </Style>
    <Style Selector="Button.quiet:pressed /template/ Border#Pill">
        <Setter Property="Opacity" Value="0.7" />
        <Setter Property="RenderTransform" Value="scale(0.97)" />
    </Style>
    <Style Selector="Button.quiet:disabled /template/ Border#Pill">
        <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="Button.accent">
        <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
        <Setter Property="Background" Value="{DynamicResource Accent}" />
    </Style>

    <!-- Footer links -->
    <Style Selector="Button.link">
        <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" />
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.link:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ TextBlock">
        <Setter Property="TextDecorations" Value="Underline" />
    </Style>

    <!-- Accent colour swatch -->
    <Style Selector="RadioButton.swatch">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid Width="28" Height="28" Background="Transparent">
                    <Ellipse Name="Ring" Stroke="{DynamicResource Text}" StrokeThickness="2" Opacity="0" />
                    <Ellipse Margin="4" Fill="{TemplateBinding Background}" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.swatch:checked /template/ Ellipse#Ring">
        <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- On/off switch -->
    <Style Selector="CheckBox.switch">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Track" Width="44" Height="26" CornerRadius="13" Background="{DynamicResource Raised}">
                    <Ellipse Name="Thumb" Width="20" Height="20" Fill="White" HorizontalAlignment="Left" Margin="3,0"
                             RenderTransform="translateX(0px)" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="CheckBox.switch:checked /template/ Border#Track">
        <Setter Property="Background" Value="{DynamicResource Accent}" />
    </Style>
    <!-- Moved rather than re-aligned, so it can slide: 44 track - 20 thumb - 2 × 3 margin = 18. -->
    <Style Selector="CheckBox.switch:checked /template/ Ellipse#Thumb">
        <Setter Property="RenderTransform" Value="translateX(18px)" />
    </Style>

    <!-- Transitions, only while the Animations setting is on (MainWindow adds the class) -->
    <Style Selector=".animated RadioButton.nav /template/ Border#Pill, .animated RadioButton.segment /template/ Border#Pill">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector=".animated Button.quiet /template/ Border#Pill">
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector=".animated CheckBox.switch /template/ Border#Track">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.2" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector=".animated CheckBox.switch /template/ Ellipse#Thumb">
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>

    <!-- Tooltips in the app's colours -->
    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{DynamicResource Card}" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
        <Setter Property="FontSize" Value="13" />
    </Style>
</Styles>
